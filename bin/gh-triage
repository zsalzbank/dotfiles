#!/usr/bin/env bash
# Launcher for gh_triage.py, which needs `textual` for its TUI.
#
# Self-bootstrapping on purpose: this and the two .py files beside it are the
# whole program, so it runs from a clone, a copy, or a single directory on any
# machine without the dotfiles installer having been near it. A shebang can't
# point at a venv, hence a shell wrapper rather than a plain script.
#
# Interpreter, in order of preference:
#   1. $GH_TRIAGE_PYTHON, if set (bring your own environment)
#   2. a venv this script created, under the user data dir
#   3. the repo-local venv, when installed from the dotfiles
#   4. system python3, if textual already imports there
#   5. otherwise: build the user venv now (uv, else python3 -m venv)
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
prog="$here/gh_triage.py"
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/gh-triage"
venv="$data_dir/venv"
repo_venv="$here/../.venv-gh-triage"

has_textual() { "$1" -c 'import textual' >/dev/null 2>&1; }

if [[ -n "${GH_TRIAGE_PYTHON:-}" ]]; then
  exec "$GH_TRIAGE_PYTHON" "$prog" "$@"
fi
for candidate in "$venv/bin/python" "$repo_venv/bin/python"; do
  if [[ -x "$candidate" ]] && has_textual "$candidate"; then
    exec "$candidate" "$prog" "$@"
  fi
done
if command -v python3 >/dev/null 2>&1 && has_textual python3; then
  exec python3 "$prog" "$@"
fi

# `clean` is stdlib-only, so don't make a broken venv block the one subcommand
# that never needed one.
if [[ "${1:-}" == "clean" ]] && command -v python3 >/dev/null 2>&1; then
  exec python3 "$prog" "$@"
fi

echo "gh-triage: setting up its python environment (one time)..." >&2
mkdir -p "$data_dir"
if command -v uv >/dev/null 2>&1; then
  uv venv "$venv" >/dev/null 2>&1 &&
    uv pip install --quiet --python "$venv/bin/python" textual >/dev/null 2>&1 || true
fi
if ! has_textual "$venv/bin/python" 2>/dev/null; then
  python3 -m venv "$venv" >/dev/null 2>&1 &&
    "$venv/bin/pip" install --quiet textual >/dev/null 2>&1 || true
fi
if [[ -x "$venv/bin/python" ]] && has_textual "$venv/bin/python"; then
  exec "$venv/bin/python" "$prog" "$@"
fi

cat >&2 <<EOF
gh-triage: could not install textual into $venv

Install it yourself and point at that interpreter, e.g.
  python3 -m venv ~/.local/share/gh-triage/venv
  ~/.local/share/gh-triage/venv/bin/pip install textual
or set GH_TRIAGE_PYTHON to a python that already has it.

\`gh-triage clean\` needs no dependencies and works regardless.
EOF
exit 1
